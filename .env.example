# ===== Database (Neon Serverless Postgres) =====
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ===== Authentication (NextAuth v5) =====
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-64-char-hex-string

# ===== LiveKit (Real-time Audio/Video) =====
LIVEKIT_API_KEY=livekit-api-key
LIVEKIT_API_SECRET=livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ===== Vercel Blob (File Storage) =====
# REQUIRED: Get this from Vercel Dashboard > Storage > Blob > "Create Token"
# Without this token, file upload, download, and delete operations will fail.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ===== VST Plugin (Phase 3, local only) =====
# WebSocket port for DAW-to-browser audio streaming
VST_WS_PORT=9420

# ===== AI Features =====
# LLM API endpoint (OpenAI-compatible)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-your-api-key
AI_MODEL=gpt-4o-mini
